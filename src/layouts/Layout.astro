---
import Analytics from '@vercel/analytics/astro'
---
<!doctype html>

<html lang="en">

	<head>
		<Analytics/>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />

		<link rel="icon" type="image/svg+xml" href="/icons/power.svg"/>

		<title>totaldecoy</title>

  		<meta property="og:title" content="totaldecoy" />

 		 <meta property="og:type" content="website" />

 		 <meta property="og:url" content="https://totaldecoy.net" />

 		 <meta property="og:image" content="https://totaldecoy.net/og-image.png" />

 		 <meta name="twitter:card" content="summary_large_image" />

  		<meta name="twitter:title" content="totaldecoy" />

  		<meta name="twitter:image" content="https://totaldecoy.net/og-image.png" />

  		<meta name="generator" content={Astro.generator} />
	</head>

	<body>
		<a href="/" class="home">
			<img src="/icons/power.svg" alt="home" />
		</a>
		<slot />
	</body>

</html>

<style>

:root {

  --gutter: 60px;

}

html,

body {

  margin: 0;

  min-height: 100vh;

}

body {

  margin: 0;

  padding: 40px 0 0 var(--gutter);

  font-family: Garamond, serif;

}

.home {

  position: fixed;

  top: 40px;

  left: 10px;

}

.home img {

  width: 32px;

}

</style>