---
import Analytics from '@vercel/analytics/astro'
import SpeedInsights from '@vercel/speed-insights/astro'
---
<!doctype html>

<html lang="en">

	<head>
		<Analytics/>
		<SpeedInsights/> 
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />

		<link rel="icon" type="image/svg+xml" href="/icons/power.svg"/>

		<title>totaldecoy</title>

  		<meta property="og:title" content="totaldecoy" />

 		 <meta property="og:type" content="website" />

 		 <meta property="og:url" content="https://totaldecoy.net" />

 		 <meta property="og:image" content="https://totaldecoy.net/og-image.png" />

 		 <meta name="twitter:card" content="summary_large_image" />

  		<meta name="twitter:title" content="totaldecoy" />

  		<meta name="twitter:image" content="https://totaldecoy.net/og-image.png" />

  		<meta name="generator" content={Astro.generator} />
	</head>

	<body>
		<a href="/" class="home">
		 <picture>
		  <source
      		srcset="/icons/power-sign-white.svg"
		 	media="(prefers-color-scheme: dark)"
		  />
		  <img src="/icons/power.svg" alt="home" />
	     </picture>
		</a>

		<slot />
	</body>

</html>

<style>

:root {

  --gutter: 60px;

  --bg: #ffffff;
  --text: #111111;
  --link: #111111;
}



@media (prefers-color-scheme: dark) {

  :root {

    --bg: #000000;
    --text: #eeeeee;
    --link: #ff1d1d;
  }
}

html,
body {

  margin: 0;
  min-height: 100vh;

}

body {
  margin: 0;
  padding: 40px 0 0 var(--gutter);
  font-family: Garamond, serif;

  background: var(--bg);
  color: var(--text);

}

a,
a:visited {
  color: var(--link);
}

.home {
  position: fixed;
  top: 40px;
  left: 10px;
}

.home img {

  width: 32px;

}



</style>