<main class="site">

  <div class="spread">

    <section class="page left">

      <h1>Total Decoy</h1>

      <p>

        This is where your writing will go.

      </p>

    </section>

    <section class="page right">

      <p>

        This is the other side of the spread.

      </p>

      <a href="/page-02" class="ad">

        ADVERTISEMENT

      </a>

    </section>

  </div>

</main>

<style>

  html,

  body {

    margin: 0;

    min-height: 100%;

  }

  body {

    background: linear-gradient(

      135deg,

      #dce9f8 0%,

      #8eacd7 50%,

      #536f9e 100%

    );

  }

  .site {

    min-height: 100vh;

    overflow-x: auto;

    overflow-y: auto;

  }

  .spread {

    width: 1200px;

    min-height: 800px;

    margin: 5vh auto;

    display: grid;

    grid-template-columns: 1fr 1fr;

    background: #f5f3ec;

  }

  .page {

    position: relative;

    padding: 60px;

    box-sizing: border-box;

  }

  .left {

    border-right: 1px solid #ddd;

  }

  .right {

    border-left: 1px solid #eee;

  }

  .ad {

    display: block;

    margin-top: 100px;

  }

  @media (max-width: 700px) {

    .site {

      overflow-x: auto;

    }

    .spread {

      width: 900px;

      margin: 20px;

    }

  }

</style>