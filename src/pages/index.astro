---

import Layout from '../layouts/Layout.astro';

---

<Layout>

 <main>

  <nav>

    <a href="/log" class="log">
    <img src="/icons/log-clear.svg" alt="log" />
    </a>

    <a href="/contact" class="contact">
    <img src="/icons/contact-clear.svg" alt="contact" />
    </a>

    <a href="/search" class="search">
    <img src="/icons/search-clear.svg" alt="search" />
    </a>

  </nav>

 </main>

</Layout>

<style> 


nav {

  position: fixed;

  top: 56px; /* or 52px, 60px—experiment */

  display: block;

}


nav a {

  display: inline-block;

  text-decoration: none;

  line-height: 1;

}

nav a + a {

  margin-left: 24px;

}


</style>
