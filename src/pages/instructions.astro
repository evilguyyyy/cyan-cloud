<!doctype html>

<html lang="en">

  <head>

    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="theme-color" content="#000000" />

    <title>Instructions</title>

  </head>

  <body>

    <main class="page">

      <section class="display" aria-label="Participant instructions">

        <div class="led-grid" aria-hidden="true"></div>

        <p class="display-text">WELCOME, PARTICIPANT.</p>

      </section>

      <section class="content">

        <p class="typing-text">Thank you for joining...</p>

        <a

          href="/instructions/here"

          class="continue"

          aria-label="Continue to instructions"

        >

          <img src="/icons/friend.svg" alt="" />

        </a>

      </section>

    </main>

    <script>

  const button = document.querySelector<HTMLAnchorElement>('.continue');

  const icon = button?.querySelector('img');

  button?.addEventListener('click', (event) => {

    event.preventDefault();

    icon?.classList.remove('shake');

    // Restart the animation on every click

    void icon?.getBoundingClientRect();

    icon?.classList.add('shake');

    setTimeout(() => {

      window.location.href = button.href;

    }, 300);

  });

</script>

  </body>

</html>



<style>
  

  :global(*) {

    box-sizing: border-box;

  }

  :global(html) {

  background: #000;

}

:global(body) {

  margin: 0;

  background: #000;

  color: #e9e9e6;

  font-family: Arial, Helvetica, sans-serif;

  -webkit-font-smoothing: antialiased;

}

  .page {

    position: relative;

    min-height: 100vh;

    min-height: 100svh;

    padding: 28px 5vw 20px;

    display: flex;

    flex-direction: column;

    justify-content: center;

  }

  /* LED DISPLAY */

  .display {

    position: relative;

    width: 100%;

    max-width: 1000px;

    min-height: 130px;

    margin: 0 auto;

    display: flex;

    align-items: center;

    justify-content: center;

    overflow: hidden;

    background: #171918;

    border: 5px solid #30312f;

    box-shadow:

      inset 0 0 0 1px #090a09,

      0 2px 3px rgb(0 0 0 / 10%);

  }

  .led-grid {

    position: absolute;

    inset: 8px;

    background-image: radial-gradient(

      circle,

      rgb(180 190 181 / 22%) 1px,

      transparent 1.5px

    );

    background-size: 6px 6px;

    pointer-events: none;

  }

  .display-text {

    position: relative;

    z-index: 1;

    width: 100%;

    margin: 0;

    padding: 20px;

    color: #91bca4;

    font-family: "Courier New", monospace;

    font-size: clamp(16px, 3.1vw, 34px);

    font-weight: 400;

    letter-spacing: 0.04em;

    text-align: center;

    overflow-wrap: anywhere;

    text-shadow: 0 0 8px rgb(115 190 150 / 15%);

  }

  /* CONTENT */

  .content {

    width: 100%;

    max-width: 1000px;

    margin: 0 auto;

    padding: 30px 2px 0;

    display: flex;

    justify-content: space-between;

    align-items: center;

  }

  .content p {

    margin: 0;

    font-size: 15px;

    font-weight: 400;

    letter-spacing: -0.02em;

  }

  .continue {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    padding: 8px;

    color: inherit;

    text-decoration: none;

  }

.continue img {

  display: block;

  width: 64px !important;

  height: 64px !important;

  min-width: 64px;

  min-height: 64px;

  object-fit: contain;

  filter: invert(1);

  animation: beckon 1.2s ease-in-out infinite;

}

  .continue:hover img {

    transform: rotate(12deg);

  }

  .continue:focus-visible {

    outline: 1px solid #777;

    outline-offset: 3px;

  }

  /* FOOTER */

  footer {

    position: absolute;

    bottom: 20px;

    left: 5vw;

    right: 5vw;

    display: flex;

    justify-content: space-between;

    color: #858680;

    font-size: 10px;

    letter-spacing: 0.02em;

  }

  /* MOBILE */

  @media (max-width: 600px) {

    .page {

      padding: 20px;

    }

    .display {

      min-height: 100px;

      border-width: 4px;

    }

    .display-text {

      padding: 12px;

      font-size: clamp(13px, 4vw, 22px);

    }

    .content {

      padding-top: 24px;

    }

    .continue img {

      width: 28px;

      height: 28px;

    }

    footer {

      left: 20px;

      right: 20px;

    }

  }

  @media (prefers-reduced-motion: reduce) {

    .continue img {

      transition: none;

    }

  }

.typing-text {

  display: inline-block;

  width: 0;

  margin: 0;

  white-space: nowrap;

  overflow: hidden;

  border-right: 1px solid currentColor;

  font-size: 15px;

  font-weight: 400;

  letter-spacing: -0.02em;

  animation:

    typing 2s steps(18, end) 0.4s forwards,

    cursor 0.7s step-end infinite;

}

@keyframes typing {

  from { width: 0; }

  to { width: 18ch; }

}

@keyframes cursor {

  50% { border-color: transparent; }

}
@media (prefers-reduced-motion: reduce) {
  .typing-text {
    width: 15ch;
    animation: none;
    border-right: none;
  }
}

.continue:active img {

  animation: click-shake 300ms ease-in-out;

}

.continue img.shake {

  animation: click-shake 300ms ease-in-out;

}

.continue img {

  display: block;

  width: 18px;

  height: 18px;

  object-fit: contain;

  filter: invert(1);

  animation: beckon 1.2s ease-in-out infinite;

}

@keyframes beckon {

  0%, 100% {

    transform: rotate(0deg);

  }

  15% {

    transform: rotate(-12deg);

  }

  30% {

    transform: rotate(12deg);

  }

  45% {

    transform: rotate(-10deg);

  }

  60% {

    transform: rotate(8deg);

  }

  75% {

    transform: rotate(0deg);

  }

}

@media (prefers-reduced-motion: reduce) {

  .continue img {

    animation: none;

  }

}

</style>