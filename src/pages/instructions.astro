<!doctype html>

<html lang="en">

  <head>

    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="theme-color" content="#000000" />

    <title>Instructions</title>

  </head>

  <body>

    <main class="page">

      <section class="display" aria-label="Participant instructions">

  <div class="led-window">

    <div class="led-track">

      <div class="led-matrix" aria-hidden="true"></div>

      <div class="led-matrix led-copy" aria-hidden="true"></div>

    </div>

  </div>

</section>

      <section class="content">

        <p class="typing-text">Thank you for joining...</p>

        <a

          href="/instructions/here"

          class="continue"

          aria-label="Continue to instructions"

        >

          <img src="/icons/friend.svg" alt="" />

        </a>

      </section>

    </main>

    <script>
  const message = "WELCOME, PARTICIPANT.";

  const font: Record<string, string[]> = {
    W: ["10001", "10001", "10001", "10101", "10101", "10101", "01010"],
    A: ["01110", "10001", "10001", "11111", "10001", "10001", "10001"],
    C: ["01111", "10000", "10000", "10000", "10000", "10000", "01111"],
    E: ["11111", "10000", "10000", "11110", "10000", "10000", "11111"],
    I: ["11111", "00100", "00100", "00100", "00100", "00100", "11111"],
    L: ["10000", "10000", "10000", "10000", "10000", "10000", "11111"],
    M: ["10001", "11011", "10101", "10101", "10001", "10001", "10001"],
    N: ["10001", "11001", "11001", "10101", "10011", "10011", "10001"],
    O: ["01110", "10001", "10001", "10001", "10001", "10001", "01110"],
    P: ["11110", "10001", "10001", "11110", "10000", "10000", "10000"],
    R: ["11110", "10001", "10001", "11110", "10100", "10010", "10001"],
    T: ["11111", "00100", "00100", "00100", "00100", "00100", "00100"],
    " ": ["000", "000", "000", "000", "000", "000", "000"],
    ",": ["000", "000", "000", "000", "001", "010", "100"],
    ".": ["000", "000", "000", "000", "000", "110", "110"],
  };

  const matrices = document.querySelectorAll<HTMLElement>(".led-matrix");

  const rows: number[][] = Array.from({ length: 7 }, () => []);

  for (const char of message) {
    const glyph = font[char] || font[" "];

    for (let row = 0; row < 7; row++) {
      rows[row].push(...glyph[row].split("").map(Number));
      rows[row].push(0);
    }
  }

  // Space between the message and its repeated copy.
  for (let row = 0; row < 7; row++) {
    for (let col = 0; col < 10; col++) {
      rows[row].push(0);
    }
  }

  const cols = rows[0].length;

  matrices.forEach((matrix) => {
    matrix.replaceChildren();
    matrix.style.setProperty("--cols", String(cols));

    const fragment = document.createDocumentFragment();

    for (let row = 0; row < 7; row++) {
      for (let col = 0; col < cols; col++) {
        const dot = document.createElement("span");
        dot.className = rows[row][col] ? "led on" : "led";
        fragment.appendChild(dot);
      }
    }

    matrix.appendChild(fragment);
  });
</script>

  </body>

</html>



<style>
  

  :global(*) {

    box-sizing: border-box;

  }

  :global(html) {

  background: #000;

}

:global(body) {

  margin: 0;

  background: #000;

  color: #e9e9e6;

  font-family: Arial, Helvetica, sans-serif;

  -webkit-font-smoothing: antialiased;

}

  .page {

  position: relative;

  min-height: 100vh;

  min-height: 100svh;

  padding: 28px 5vw 20px;

  display: flex;

  flex-direction: column;

  justify-content: center;

}
  /* LED DISPLAY */

  .display {

    position: relative;

    width: 100%;

    max-width: 1000px;

    height: 130px;

    flex-shrink: 0;

    margin: 0 auto;

    display: flex;

    align-items: center;

    justify-content: center;

    overflow: hidden;

    background: #171918;

    border: 5px solid #30312f;

    box-shadow:

      inset 0 0 0 1px #090a09,

      0 2px 3px rgb(0 0 0 / 10%);

}

  .led-window {

  width: 100%;

  overflow: hidden;

}

.led-track {

  display: flex;

  width: max-content;

  gap: 0;

  animation: led-scroll 18s linear infinite;

}

.led-matrix {

  display: grid;

  grid-template-columns: repeat(var(--cols), 8px);

  grid-template-rows: repeat(7, 8px);

  gap: 3px;

  width: max-content;

  flex-shrink: 0;

}

:global(.led) {

  display: block;

  width: 8px;

  height: 8px;

  border-radius: 50%;

  background: #2e332f;

}

:global(.led.on) {
  background: #fff;
  box-shadow: 0 0 4px #fff, 0 0 8px rgb(255 255 255 / 70%);
}

@keyframes led-scroll {

  from {

    transform: translateX(0);

  }

  to {

    transform: translateX(-50%);

  }

}
  /* CONTENT */

  .content {

    width: 100%;

    max-width: 1000px;

    margin: 0 auto;

    padding: 30px 2px 0;

    display: flex;

    justify-content: space-between;

    align-items: center;

  }

  .content p {

    margin: 0;

    font-size: 15px;

    font-weight: 400;

    letter-spacing: -0.02em;

  }

  .continue {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    padding: 8px;

    color: inherit;

    text-decoration: none;

  }

.continue img {

  display: block;

  width: 64px !important;

  height: 64px !important;

  min-width: 64px;

  min-height: 64px;

  object-fit: contain;

  filter: invert(1);

  animation: beckon 1.2s ease-in-out infinite;

}

  .continue:hover img {

    transform: rotate(12deg);

  }

  .continue:focus-visible {

    outline: 1px solid #777;

    outline-offset: 3px;

  }

  /* FOOTER */

  footer {

    position: absolute;

    bottom: 20px;

    left: 5vw;

    right: 5vw;

    display: flex;

    justify-content: space-between;

    color: #858680;

    font-size: 10px;

    letter-spacing: 0.02em;

  }

  /* MOBILE */

  @media (max-width: 600px) {

    
    .page {

      padding: 20px;

    }

    .display {

      min-height: 100px;

      border-width: 4px;

    }

    .display-text {

      padding: 12px;

      font-size: clamp(13px, 4vw, 22px);

    }

    .content {

      padding-top: 24px;

    }

    .continue img {

      width: 28px;

      height: 28px;

    }

    .led-matrix {

      grid-template-columns: repeat(var(--cols), 5px);

      grid-template-rows: repeat(7, 5px);

      gap: 2px;

    }

    :global(.led) {

      width: 5px;

      height: 5px;
    }

    footer {

      left: 20px;

      right: 20px;

    }

  }

  @media (prefers-reduced-motion: reduce) {

    .continue img {

      transition: none;

    }

  }

.typing-text {

  display: inline-block;

  width: 0;

  margin: 0;

  white-space: nowrap;

  overflow: hidden;

  border-right: 1px solid currentColor;

  font-size: 15px;

  font-weight: 400;

  letter-spacing: -0.02em;

  animation:

    typing 2s steps(18, end) 0.4s forwards,

    cursor 0.7s step-end infinite;

}

@keyframes typing {

  from { width: 0; }

  to { width: 18ch; }

}

@keyframes cursor {

  50% { border-color: transparent; }

}
@media (prefers-reduced-motion: reduce) {
  .typing-text {
    width: 15ch;
    animation: none;
    border-right: none;
  }
}

.continue:active img {

  animation: click-shake 300ms ease-in-out;

}

.continue img.shake {

  animation: click-shake 300ms ease-in-out;

}

.continue img {

  display: block;

  width: 18px;

  height: 18px;

  object-fit: contain;

  filter: invert(1);

  animation: beckon 1.2s ease-in-out infinite;

}

@keyframes beckon {

  0%, 100% {

    transform: rotate(0deg);

  }

  15% {

    transform: rotate(-12deg);

  }

  30% {

    transform: rotate(12deg);

  }

  45% {

    transform: rotate(-10deg);

  }

  60% {

    transform: rotate(8deg);

  }

  75% {

    transform: rotate(0deg);

  }

}

@media (prefers-reduced-motion: reduce) {

  .continue img {

    animation: none;

  }

}
.typing-text {

  display: inline-block;

  width: 0;

  margin: 0;

  white-space: nowrap;

  overflow: hidden;

  border-right: 1px solid currentColor;

  font-size: 15px;

  font-weight: 400;

  letter-spacing: -0.02em;

  animation:

    typing 2s steps(18, end) 0.4s forwards,

    cursor 0.7s step-end infinite;

}

@keyframes typing {

  from { width: 0; }

  to { width: 18ch; }

}

@keyframes cursor {

  50% { border-color: transparent; }

}
</style>