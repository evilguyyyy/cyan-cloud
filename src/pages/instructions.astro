---

import Layout from '../layouts/Layout.astro';

---

<Layout>

  <h1>

    Great, you got here. 

    What to do now? 

     <a href="/instructions/here" class="here">

      <img src="/icons/earth.svg" alt="here" class="icon" />

    </a>

  </h1>

</Layout>

<style>

  .icon {

    filter: none;

  }

  @media (prefers-color-scheme: dark) {

    .icon {

      filter: invert(1);

    }

  }

</style>